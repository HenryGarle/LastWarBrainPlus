# Copy to .env on the server and fill in. Never commit the real one.

# The address people will use; its DNS A record must point at the server before the first start.
DOMAIN=lastwar.example.com

# Long and random, e.g.  openssl rand -base64 30
POSTGRES_PASSWORD=change-me

# "off" until you have checked a guest works from the server; then "on" (hourly pulse etc.).
SCHEDULER=off

# Daily database dumps to keep in ./backups
BACKUP_DAYS=14

# Only change for a local test run where 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
